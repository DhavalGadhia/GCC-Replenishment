# ============================================================
#  SECRETS - domain allowlist for the GCC Replenishment Engine
# ============================================================
# LOCAL:  copy this file to .streamlit/secrets.toml and edit it.
# CLOUD:  paste the [auth] block into
#         Manage app -> Settings -> Secrets  (do NOT upload the file).
#
# Never commit the real secrets.toml - .gitignore already blocks it.

[auth]
# Only people with an email at one of these domains may register or sign in.
# Replace with your real domain(s). Matching is exact and case-insensitive:
# "user@yourcompany.com" is allowed, "user@mail.yourcompany.com" is NOT -
# list each subdomain separately if you use them.
allowed_domains = ["yourcompany.com"]
